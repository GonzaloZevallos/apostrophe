{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["ICON_NAMES"] }]
  },
  "overrides": [
    {
      "files": ["e2e/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@playwright/test",
                "importNames": ["test", "expect"],
                "allowTypeImports": true,
                "message": "Import test and expect from the e2e fixtures (./fixtures.js): they start the worker's own backend."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["e2e/fixtures.ts", "e2e/mobile.spec.ts", "e2e/mobile.setup.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}

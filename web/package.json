{
  "name": "apostrophe-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "preview": "vite preview",
    "icons": "node ../scripts/design/icons.mjs",
    "e2e": "sh scripts/e2e.sh",
    "i18n:baseline": "node scripts/i18n/baseline.mjs",
    "i18n:types": "I18N_TYPES_WRITE=1 vitest run scripts/i18n/resourceTypes.test.ts",
    "i18n:codemod": "node scripts/i18n/codemod.ts",
    "i18n:pseudo": "I18N_PSEUDO_WRITE=1 vitest run scripts/i18n/pseudo.test.ts",
    "i18n:missing": "I18N_MISSING_REPORT=1 vitest run scripts/i18n/missingKeys.test.ts"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "i18next": "^26.5.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.63.0",
    "@redocly/cli": "2.72.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "dependency-cruiser": "18.7.0",
    "jsdom": "^30.1.1",
    "mermaid": "12.2.0",
    "oxlint": "^1.81.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}

{
  "_": "Each design screen and how to reach the same state in the built app (agentic-system ADR-0040, Tech Lead's plan for GH-58). route: where the built app shows a screen of that name today, even an old version of it; null only when no screen of that name is built yet. path: the decided English route (navigation.md). A build issue sets route = path in the diff that ships the screen. A redrawn screen's comparison deliberately shows the old-built screen next to the new design: that mismatch is expected until its build issue lands. Each subtask adds a screen's entry only in the diff that creates its .dc.html; only the chrome subtask removes entries, together with the file. {name} placeholders come from the sample app's facts. Steps: click (exact text), fill (label + value, which takes {email} and the ids too), wait (text). tema: 'oscuro' forces the dark theme on the built capture via data-tema, the only value the app recognises (the system's own color scheme never picks it; both captures always run with colorScheme: 'light'). Main and Componentes are the design system itself, not screens, so they have no entry.",
  "screens": [
    { "screen": "Entrar", "route": "/entrar", "path": "/login", "signed_out": true,
      "steps": [
        { "fill": { "label": "Email", "value": "{email}" } },
        { "fill": { "label": "Contraseña", "value": "equivocada123" } },
        { "click": "Entrá" }
      ] },
    { "screen": "NegocioNuevo", "route": "/invitation/{new_business_token}", "path": "/invitation/{new_business_token}", "signed_out": true },
    { "screen": "Invitacion", "route": "/invitation/{join_token}", "path": "/invitation/{join_token}", "signed_out": true },
    { "screen": "Inicio", "route": "/", "steps": [{ "click": "Semana" }] },
    { "screen": "InicioOscuro", "route": "/", "tema": "oscuro", "steps": [{ "click": "Semana" }] },
    { "screen": "InicioCompu", "route": "/", "viewport": [1280, 920], "steps": [{ "click": "Semana" }] },
    { "screen": "Ventas", "route": "/ventas", "path": "/sales", "steps": [{ "click": "Semana" }] },
    { "screen": "VentasCompu", "route": "/ventas", "path": "/sales", "viewport": [1280, 920], "steps": [{ "click": "Semana" }] },
    { "screen": "NuevaVenta", "route": "/ventas/nueva", "path": "/sales/new" },
    { "screen": "NuevaVentaCliente", "route": "/ventas/nueva", "steps": [{ "click": "Elegir cliente" }] },
    { "screen": "NuevaVentaCompu", "route": "/ventas/nueva", "path": "/sales/new", "viewport": [1280, 920] },
    { "screen": "VentaDetalle", "route": "/ventas/{owing_sale}", "path": "/sales/{owing_sale}" },
    { "screen": "VentaDetalleCompu", "route": null, "path": "/sales/{owing_sale}", "viewport": [1280, 920] },
    { "screen": "Clientes", "route": "/clientes" },
    { "screen": "ClienteFicha", "route": "/clientes/{debtor}" },
    { "screen": "Cobro", "route": "/clientes/{debtor}", "steps": [{ "click": "Registrar cobro" }] },
    { "screen": "EntradaStock", "route": "/mi-stock/nueva-entrada" },
    { "screen": "Variedades", "route": "/variedades" },
    { "screen": "VariedadDetalle", "route": "/variedades/{low}" },
    { "screen": "Gastos", "route": "/gastos", "path": "/expenses" },
    { "screen": "GastosCompu", "route": null, "path": "/expenses", "viewport": [1280, 920] },
    { "screen": "GastoNuevo", "route": null, "path": "/expenses/new" },
    { "screen": "GastoNuevoCompu", "route": null, "path": "/expenses/new", "viewport": [1280, 920] },
    { "screen": "Catalogo", "route": "/catalogo" },
    { "screen": "Analisis", "route": null, "path": "/analysis" },
    { "screen": "AnalisisCompu", "route": null, "path": "/analysis", "viewport": [1280, 920] },
    { "screen": "Mas", "route": "/mas", "path": "/more" },
    { "screen": "Estados", "route": null, "path": null }
  ]
}

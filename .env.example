# Copy to .env and fill in. scripts/serve.sh and scripts/invite-business.sh load it.
# Signs session tokens and keys secrets at rest. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it closes every open session.
APOSTROPHE_SECRET_KEY=
# Optional. Defaults to sqlite:///./apostrophe.db
# APOSTROPHE_DATABASE_URL=sqlite:///./apostrophe.db
# Optional. Where users reach the app; invitation links start with it.
# Defaults to http://localhost:8000
# APOSTROPHE_PUBLIC_URL=http://192.168.0.10:8000
# Optional. Defaults to 8000.
# APOSTROPHE_PORT=8000
